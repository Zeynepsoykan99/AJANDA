{
  "expo": {
    "name": "AJANDA",
    "slug": "AJANDA",
    "scheme": "ajanda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeynepsoykan.AJANDA",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Günlüğünüzü ve kişisel defterlerinizi korumak için Face ID doğrulaması kullanılır.",
        "NSMicrophoneUsageDescription": "Sayfalarınıza sesli notlar eklemek ve kaydetmek için mikrofon erişimi gereklidir.",
        "NSSpeechRecognitionUsageDescription": "Sesli notlarınızı otomatik olarak metne dönüştürmek ve aranabilir kılmak için ses tanıma izni gereklidir."
      }
    },
    "android": {
      "package": "com.zeynepsoykan.AJANDA",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-local-authentication",
      "expo-speech-recognition",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f1a2a4b-656c-45ea-b087-0a939e2537c6"
      }
    },
    "owner": "zeynepsoykan"
  }
}
